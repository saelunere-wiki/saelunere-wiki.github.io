# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*

# Build output — regenerated by GitHub Actions on every deploy, not committed
dist/
campaign_site.html

# Session pipeline material — never public
audio/
transcripts/
speaker-maps/
proposed-updates/
*.wav
*.mp3
*.m4a
*.flac
*.srt
*.vtt

# Raw per-episode WhisperX output — source material only, never published
site-content/sessions/*/transcript/*
!site-content/sessions/*/transcript/PLACE_WHISPERX_OUTPUT_HERE.txt

# Secrets and credentials
*.token
*.key
*.pem
credentials.*
secrets.*

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local config — not part of the public site
.claude/

# DM-only material must never live here — extra safeguard beyond physical separation
site-content-dm/
dm-notes/
dm-wiki/
private/
secrets/
