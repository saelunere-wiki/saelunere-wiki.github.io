# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*

# Build output — regenerated by GitHub Actions on every deploy, not committed
dist/
campaign_site.html

# Session pipeline material — never public
audio/
transcripts/
speaker-maps/
proposed-updates/
*.wav
*.mp3
*.m4a
*.flac
*.srt
*.vtt

# Raw per-episode WhisperX output. Committed on purpose, so that players and the
# DM all work from the same source rather than passing files around. The builder
# only ever reads *.md, so none of this appears on the website - it lives in the
# repository only. Note the repository is public: anything here is public too.
#
# Committed:  the readable .txt, the timestamped .srt, and the speaker map.
# Kept out:   the word-level .json (~6MB per episode) and the redundant .vtt.
site-content/sessions/*/transcript/*
!site-content/sessions/*/transcript/*.txt
!site-content/sessions/*/transcript/*.srt
!site-content/sessions/*/transcript/speaker_map.json

# Secrets and credentials
*.token
*.key
*.pem
credentials.*
secrets.*

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local config — not part of the public site
.claude/

# DM-only material must never live here — extra safeguard beyond physical separation
site-content-dm/
dm-notes/
dm-wiki/
private/
secrets/
